"pwm_dcmotor_encoder_pid\stm32f1xx_hal_rcc.o"
"pwm_dcmotor_encoder_pid\stm32f1xx_hal_rcc_ex.o"
"pwm_dcmotor_encoder_pid\stm32f1xx_hal_gpio.o"
"pwm_dcmotor_encoder_pid\stm32f1xx_hal_dma.o"
